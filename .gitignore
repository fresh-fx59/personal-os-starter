# OS / editor cruft
.DS_Store
*.swp
*~

# Obsidian per-machine state (volatile, not worth syncing)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# Node
node_modules/
npm-debug.log*

# Agent worktrees + browser-debug artifacts (session-local, never sync)
.claude/worktrees/
.playwright-mcp/

# Personal per-machine agent overrides (never sync; CLAUDE.md itself IS committed)
CLAUDE.local.md
AGENTS.override.md

# Python bytecode (tools/)
__pycache__/
*.pyc

# limit-anchor per-machine config (paths + model choice; copy from the .example)
tools/limit-anchor/anchor.conf

# Agent SDD scratch (briefs/reports/ledgers) — session-local, never vault content
.superpowers/
